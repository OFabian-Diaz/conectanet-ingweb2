server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # IMPORTANTE (comportamiento de Nginx): si una "location" tiene su propio add_header,
    # NO hereda los add_header del bloque server. Por eso las cabeceras de seguridad del
    # frontend se repiten en cada location de archivos estáticos, y /api/ no lleva ninguna:
    # ahí mandan las de helmet en el backend (con una CSP propia que permite Swagger UI).

    # La API se sirve por el mismo origen: el navegador no necesita CORS.
    # ${BACKEND_URL} se reemplaza al arrancar el contenedor (plantilla de la imagen oficial de Nginx):
    #   docker-compose y Kubernetes: http://backend:4000   |   Azure Container Apps: http://backend
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Host del backend (no el del frontend): Azure Container Apps enruta por esta cabecera
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Archivos con hash de Vite: caché larga
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA: cualquier otra ruta carga index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always; # index.html siempre fresco tras un despliegue
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
