# Puerto de la API
PORT=4000

# Base de datos PostgreSQL (recomendado / producción)
DB_DIALECT=postgres
DATABASE_URL=postgres://conectanet:cambia_esta_clave@localhost:5432/conectanet

# Alternativa sin instalar PostgreSQL (solo desarrollo):
# DB_DIALECT=sqlite
# DB_STORAGE=./conectanet.sqlite

# Secreto para firmar los JWT: usa una cadena larga y aleatoria.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=2h

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:5173
