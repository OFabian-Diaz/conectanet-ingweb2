# Copiar a .env (no se versiona) y reemplazar los valores.
# Generar valores aleatorios con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Contraseña del usuario "conectanet" de PostgreSQL
POSTGRES_PASSWORD=cambiar_por_valor_aleatorio

# Secreto para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET=cambiar_por_valor_aleatorio_largo

# Contraseña del usuario admin de Grafana
GRAFANA_ADMIN_PASSWORD=cambiar_por_valor_aleatorio
